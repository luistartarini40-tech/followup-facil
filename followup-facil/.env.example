# Copie este arquivo para ".env.local" e preencha.
# Onde achar: Supabase > Project Settings > API (ou "API Keys").

# URL do projeto. Ex.: https://abcdefghijk.supabase.co
# (só até o ".co" — sem "/rest/v1/" no final)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do projeto ("anon" ou "publishable"). Pode ficar no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço do seu sistema. Local: http://localhost:3000
# Em produção: https://seudominio.com.br (sem barra no final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fuso horário usado para decidir o que é "hoje" (opcional).
NEXT_PUBLIC_APP_TIMEZONE=America/Sao_Paulo

# SOMENTE para rodar "npm run test:rls" na sua máquina.
# É a chave secreta ("service_role" ou "secret"). NÃO coloque na Vercel.
SUPABASE_SERVICE_ROLE_KEY=
